# Public URL of your site
# Keep data/articles.local.json in repo as SEO fallback snapshot
SITE_URL=https://www.whalewzrd.com
# Optional server-side key for the admin PageSpeed checker.
# Keep it in Cloudflare Pages secrets; never expose it as VITE_*.
PAGESPEED_API_KEY=

# Optional build-time source for published D1 page/FAQ text used by static SEO HTML.
# Defaults to ${SITE_URL}/api/site-content. In non-strict builds, a failed
# request falls back to the last local build snapshot and then source copy.
SITE_CONTENT_PUBLIC_URL=
SITE_CONTENT_FETCH_TIMEOUT_MS=8000
# Recommended in production once the deploy hook is configured: fail a build
# instead of publishing stale SEO HTML when the live D1 snapshot cannot load.
REQUIRE_FRESH_SITE_CONTENT=false

# JSONBin read endpoint for latest articles
JSONBIN_URL=https://api.jsonbin.io/v3/b/69de47b136566621a8b15081/latest

# Optional for private bins (build scripts)
JSONBIN_ACCESS_KEY=
JSONBIN_MASTER_KEY=

# Optional strict mode for CI (fail build if JSONBin + fallback unavailable)
STRICT_ARTICLES_FETCH=false
ARTICLES_FETCH_RETRIES=3
ARTICLES_FETCH_TIMEOUT_MS=10000

# Optional browser-side read key (public in frontend bundle)
VITE_JSONBIN_ACCESS_KEY=

# Meta Conversions API (server-side)
# META_CAPI_ACCESS_TOKEN is secret and should be set in Cloudflare, not committed.
VITE_META_PIXEL_ID=926332213606723
META_CAPI_API_VERSION=v25.0
META_CAPI_TEST_CODE=
META_CAPI_DEBUG_SECRET=
META_OUTBOX_MAX_ATTEMPTS=8
# Optional Meta Limited Data Use / data processing options.
# Example for automatic Meta geolocation: META_CAPI_DATA_PROCESSING_OPTIONS=LDU, COUNTRY=0, STATE=0.
META_CAPI_DATA_PROCESSING_OPTIONS=
META_CAPI_DATA_PROCESSING_OPTIONS_COUNTRY=
META_CAPI_DATA_PROCESSING_OPTIONS_STATE=

# Tracking request signature rollout. The browser does not hold this secret,
# so keep monitor mode until a trusted signer/proxy is introduced.
# TRACKING_HMAC_SECRET must be exactly 32 random bytes encoded as 64 hex chars.
TRACKING_HMAC_SECRET=
TRACKING_SIGNATURE_MODE=monitor
TRACKING_SIG_TTL_SEC=60

# Load GA4 + Yandex directly. Use "gtm" only when the GTM container owns the
# matching tags and consent-aware triggers.
VITE_ANALYTICS_RUNTIME=direct

# Telegram lead notifications (both are secrets, set in Cloudflare Pages).
# When set, /api/lead sends leads to Telegram directly and the old
# Google Apps Script proxy is no longer used.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: global Cloudflare cache purge after saving articles in admin.
# Without these only the current data center cache is cleared.
# CF_ZONE_ID is an identifier, not a credential; store it as Plaintext.
# CF_CACHE_PURGE_TOKEN is a Secret with only the Zone.Cache Purge permission.
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
# Secret production-branch deploy hook. It is required only for automatic
# synchronization: publishing D1 text starts a Pages build, which refreshes
# the static SEO HTML after that build completes successfully.
CF_PAGES_DEPLOY_HOOK_URL=
