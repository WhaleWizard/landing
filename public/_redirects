# Keep static data files accessible (do not rewrite to SPA index)
/articles.seed.json /articles.seed.json 200

# Canonical host redirect (avoid duplicate www/non-www indexing)
https://whalewzrd.com/* https://www.whalewzrd.com/:splat 301!

# Старый адрес /api/article переадресуется функцией functions/api/article.ts
# кодом 308. Здесь правила нет намеренно: для /api/* запрос обрабатывает
# функция, а вторая запись с другим кодом (302) только противоречила бы ей.
#
# Все публичные роуты SPA пре-рендерятся в собственные каталоги, поэтому
# общего фолбэка на index здесь тоже нет — он создавал бы soft-404.
